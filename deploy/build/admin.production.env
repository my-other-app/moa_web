# Build-time values of the PRODUCTION main portal image
# (ghcr.io/my-other-app/moa-admin:<sha>), for the self-hosted Oracle box.
#
# The Docker build reads this file (Dockerfile: build secret `build_env`,
# passed by .github/workflows/images.yml). NEXT_PUBLIC_* end up in the
# browser bundles, so PUBLIC values only; SENTRY_AUTH_TOKEN is a GitHub
# secret instead. KEY=value, no quotes, # comments. Copy the values from the
# Vercel project moa-admin-next (Settings -> Environment Variables ->
# Production). MOA_API_URL is not here: it is read at run time (the box sets
# it). Vercel never reads this file.

# Google's public OAuth web client id, for "Continue with Google" on the
# login page (empty: no Google button). The same web client the public site
# uses and the API checks tokens against (its APP_GOOGLE_WEB_CLIENT_ID); this
# site's origin must be one of its Authorised JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=497245325238-ceiht9g22u4eh9a3mdkmfbssa0fkevt1.apps.googleusercontent.com
# Sentry (empty DSN: off). The release is moa-admin@<commit>, set by the build.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Source maps upload only when these two and the SENTRY_AUTH_TOKEN secret are set.
SENTRY_ORG=
SENTRY_PROJECT=
