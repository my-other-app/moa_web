# Build-time values of the STAGING main portal image
# (ghcr.io/my-other-app/moa-admin:staging-<sha>), for
# https://main-portal-staging.myotherapp.in. Same rules as
# admin.production.env: public values only, KEY=value, no quotes.

# Google's web client id for "Continue with Google". Empty: no Google button
# here, as the staging origin isn't one of the client's JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ORG=
SENTRY_PROJECT=
