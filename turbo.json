{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "globalEnv": [
    "MOA_API_URL",
    "NODE_ENV"
  ]
}
