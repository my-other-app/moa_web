{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_SENTRY_*",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_DEPLOYMENT_ID"
      ],
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN",
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "globalEnv": [
    "MOA_API_URL",
    "NODE_ENV"
  ]
}
