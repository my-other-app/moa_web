# Upstream API origin. Used server-side (RSC, route handlers) and by the
# /api/gateway BFF. Never exposed to the browser: the client only ever calls
# this app's own origin, which is what keeps the auth cookie first-party.
MOA_API_URL=https://api.myotherapp.in

# Sentry error tracking. While this is empty Sentry is off entirely: the SDK
# is never started and nothing is sent. The DSN is public by design; it only
# lets a browser submit events.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: the share of requests traced, 0 to 1. Defaults to 0.05.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Optional overrides. By default the environment is Vercel's (production or
# preview) and the release is moa-admin@<commit>.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Build time only, to upload source maps: set all three or none. The token is
# a secret -- set it in Vercel, never here and never as NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
